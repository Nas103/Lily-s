# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Admin bootstrap account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# AI providers
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""
SUPPORT_TO_EMAIL=""
SUPPORT_FROM_EMAIL=""

# PayFast (web / ZA)
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"

# Stripe (in-app payments)
# Server-side secret key (sk_test_... / sk_live_...) — NEVER expose to clients.
STRIPE_SECRET_KEY=""
# Publishable key (pk_test_... / pk_live_...). Safe to expose; also given to the app.
STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret from the Stripe Dashboard (whsec_...).
STRIPE_WEBHOOK_SECRET=""
# Currency Stripe charges in (Stripe settles in your account currency).
STRIPE_CURRENCY="usd"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
JWT_SECRET="change-me"
